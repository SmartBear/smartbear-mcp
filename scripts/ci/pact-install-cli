#!/usr/bin/env bash
# Set up the `pact-broker` compatibility shim for the PactFlow unified CLI
#
# The Pact CLI itself is installed by mise (see mise.toml; in GitHub Actions via
# jdx/mise-action). The new CLI (0.10+) consolidates all commands under a single
# `pact` binary; pact-broker is now a subcommand (`pact broker`). This script
# creates a `pact-broker` shim so existing scripts continue to work, and, in
# GitHub Actions, appends the shim directory to GITHUB_PATH.
#
# Usage (requires `pact` on PATH, e.g. `mise install && eval "$(mise activate bash)"`):
#   scripts/ci/pact-install-cli
#
set -euo pipefail

command -v pact >/dev/null 2>&1 || { echo "pact not found on PATH; install it with mise first" >&2; exit 1; }

SHIM_DIR="${HOME}/.pact/bin"
mkdir -p "$SHIM_DIR"

cat > "${SHIM_DIR}/pact-broker" <<SHIM
#!/usr/bin/env bash
exec "$(command -v pact)" broker "\$@"
SHIM
chmod +x "${SHIM_DIR}/pact-broker"

export PATH="${SHIM_DIR}:${PATH}"
if [ -n "${GITHUB_PATH-}" ]; then
  printf '%s\n' "$SHIM_DIR" >> "$GITHUB_PATH"
fi

command -v pact-broker >/dev/null 2>&1 || { echo "pact-broker not found after setup" >&2; exit 1; }
